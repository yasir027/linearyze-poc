# Copy to .env. Keep .env out of git.
# Placeholder: the app runs without a language model and answers with the closest quote.
ANTHROPIC_API_KEY=dummy-key-replace-me
# Set a real key (starts with sk-ant-) to enable model-written answers.
CLAUDE_MODEL=claude-sonnet-5-5

# hashing (default, no download) or bge-m3 (needs requirements-ml.txt)
EMBEDDER=hashing
# lexical (default, no download) or bge (needs requirements-ml.txt)
RERANKER=lexical
RELEVANCE_THRESHOLD=0.5
